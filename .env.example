# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
# Real shell environment variables always override values in this file.
#
# Every breach source below is OPTIONAL. `ohosint breach` works with no keys
# at all; these only unlock additional providers.

# Have I Been Pwned — paid key. Enables per-account breach search.
OHO_HIBP_KEY=

# Intelligence X — free developer key from https://intelx.io/account?tab=developer
OHO_INTELX_KEY=

# BreachDirectory via RapidAPI — free tier is ~10 requests/month.
OHO_RAPIDAPI_KEY=

# EmailRep — raises the very small keyless quota.
OHO_EMAILREP_KEY=
